PORT=5001
NODE_ENV=development
JWT_SECRET=change_me
MONGO_URI=mongodb://root:password@localhost:27017/uniplatform?authSource=admin&replicaSet=rs0

# Frontend
VITE_API_URL=http://localhost:5001

# Google Drive
GOOGLE_DRIVE_MOCK=true
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Recording bot
RECORDING_ENABLED=true
RECORDINGS_DIR=/tmp/uniplatform-recordings
RECORDING_SOCKET_URL=http://localhost:5001
BACKEND_PUBLIC_URL=http://localhost:5001
MAX_RECORDING_MINUTES=180
FFMPEG_PATH=ffmpeg

# Python transcription service
PYTHON_API_URL=http://localhost:8000
TRANSCRIPTION_TIMEOUT_MS=1800000
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=vi
WHISPER_PRELOAD_MODEL=true
WHISPER_WORD_TIMESTAMPS=false
WHISPER_BEAM_SIZE=3
WHISPER_RETRY_UNCERTAIN_SEGMENTS=true
WHISPER_RETRY_MAX_SEGMENTS=3
WHISPER_RETRY_BEAM_SIZE=5
WHISPER_RETRY_PADDING_SECONDS=0.4
WHISPER_UNCERTAIN_LOGPROB_THRESHOLD=-0.75
WHISPER_UNCERTAIN_NO_SPEECH_THRESHOLD=0.55
WHISPER_UNCERTAIN_COMPRESSION_THRESHOLD=2.4
# Optional domain vocabulary for Vietnamese meetings.
# WHISPER_HOTWORDS=UniPlatform Prisma Ragas Ollama
# WHISPER_INITIAL_PROMPT=Cuộc họp tiếng Việt về dự án UniPlatform.

# Ollama summary
# Docker: dùng host.docker.internal để kết nối Ollama trên máy host
# Local (không Docker): đổi lại thành http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_JSON_RETRIES=2
OLLAMA_TIMEOUT_MS=300000
MEETING_SUMMARY_CHUNK_CHARS=6000
SUMMARY_SCORE_ENABLED=true
SUMMARY_SCORE_THRESHOLD=0.55
SUMMARY_SCORE_CONCISENESS_COEFF=0.5
SUMMARY_SCORE_MODEL=qwen3:1.7b
SUMMARY_SCORE_TIMEOUT_MS=300000

# Docker Desktop on macOS: use this for backend-node containers instead of localhost.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
