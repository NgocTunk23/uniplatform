// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  username    String    @unique
  password    String
  fullname    String
  role        String    @default("Member")
  dateofbirth DateTime?
  address     String?
  email       String    @unique
  phone       String?
  status      String    @default("active")
  createdat   DateTime?  @default(now()) @map("createdAt")
  tokenVersion BigInt?   @default(0)   @map("tokenVersion")
  imageggid   String?

  // Navigation properties for relationships
  schedules      Schedules[]
  systemLogs     SystemLog[]
  meetingMinutes MeetingMinutes[]

  resetToken       String?
  resetTokenExpiry DateTime?
}

model Schedules {
  scheduleid  String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String
  title       String
  description String?
  starttime   DateTime
  endtime     DateTime
  type        String
  createdat    DateTime? @default(now()) @map("createdAt")

  user        User     @relation(fields: [username], references: [username])
}

model Workspace {
  workspaceid String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  admin       String
  member      Member[]
  createdat   DateTime? @default(now()) @map("createdAt")

  messages    Messages[]
  meetings    Meeting[]
}

type Member {
  username      String
  workspacerole String   @default("Member")
  joinedat      DateTime? @default(now()) @map("joinedAt")
}

model Messages {
  messageid       String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceid     String   @db.ObjectId
  senderusername  String
  content         String
  createdat        DateTime? @default(now()) @map("createdAt")
  reply           String?
  userid          String[]
  vectorembedding Float[]

  workspace       Workspace @relation(fields: [workspaceid], references: [workspaceid])
  files           Files[]
}

model Meeting {
  meetingid      String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceid    String   @db.ObjectId
  title          String
  starttime      DateTime
  endtime        DateTime
  organizer      String
  participants   String[]
  status         String
  createdat       DateTime? @default(now()) @map("createdAt")
  link           String?
  place          String?
  bot_status     String?
  recording_file String?

  workspace      Workspace       @relation(fields: [workspaceid], references: [workspaceid])
  meetingMinute  MeetingMinutes?
}

model MeetingMinutes {
  meetingminuteid String   @id @default(auto()) @map("_id") @db.ObjectId
  meetingid       String   @unique @db.ObjectId
  createby        String
  content         String?
  task            String[]
  createdat        DateTime? @default(now()) @map("createdAt")
  updatedat        DateTime? @updatedAt    @map("updatedAt")
  raw_transcript  String?
  summary         String?
  decisions       String[]
  isbotgenerated  Boolean?
  vectorembedding Float[]

  meeting         Meeting  @relation(fields: [meetingid], references: [meetingid])
  user            User     @relation(fields: [createby], references: [username])
  files           Files[]
}

model Files {
  fileid          String   @id @default(auto()) @map("_id") @db.ObjectId
  uploader        String
  messageid       String?  @db.ObjectId
  meetingminuteid String?  @db.ObjectId
  filename        String
  ggid            String
  typefile        String?
  sizefile        String?
  createdat        DateTime? @default(now()) @map("createdAt")

  message         Messages?       @relation(fields: [messageid], references: [messageid])
  meetingMinute   MeetingMinutes? @relation(fields: [meetingminuteid], references: [meetingminuteid])
}

model SystemLog {
  logid          String      @id @default(auto()) @map("_id") @db.ObjectId
  actorusername  String
  targetresource String
  targetid       String?
  changes        LogChange[]
  createdat       DateTime?   @default(now()) @map("createdAt")

  user           User        @relation(fields: [actorusername], references: [username])
}

type LogChange {
  field String
  new   Json?
  old   Json?
}